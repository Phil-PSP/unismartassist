SECRET_KEY=replace-with-a-unique-random-secret-key-of-at-least-50-characters
DEBUG=False
DJANGO_ALLOW_INSECURE_DEBUG=False
ALLOWED_HOSTS=your-production-domain.example,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-production-domain.example
CSRF_TRUSTED_ORIGINS=https://your-production-domain.example

# Database
DB_NAME=kaaf_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=yourpassword
EMAIL_USE_TLS=True

# OpenAI (set only the provider key you actually use)
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_API_KEY=replace-with-your-google-gemini-api-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Production defaults. For local HTTP development only, override the first three to False.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
TRUST_X_FORWARDED_PROTO=True
